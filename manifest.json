  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "description": "Open the ReeferDude home experience and primary landing page.",
      "url": "/",
      "icons": [
        {
          "src": "/assets/icons/shortcut-home.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Marketplace",
      "short_name": "Market",
      "description": "Open the marketplace and discovery experience for products and brand listings.",
      "url": "/marketplace",
      "icons": [
        {
          "src": "/assets/icons/shortcut-market.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Directory",
      "short_name": "Directory",
      "description": "Browse trusted directory and catalog views across the ReeferDude platform.",
      "url": "/directory",
      "icons": [
        {
          "src": "/assets/icons/shortcut-directory.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Contact",
      "short_name": "Contact",
      "description": "Go directly to the contact and trust communication channels.",
      "url": "/contact",
      "icons": [
        {
          "src": "/assets/icons/shortcut-contact.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "text/*"
          ]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+reeferdude",
      "url": "/open?target=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "application/json": [
          ".json"
        ],
        "text/plain": [
          ".txt"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 420
  }
}
